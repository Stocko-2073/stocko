+"""Overlay ZeroPlantSeg outputs on the source image."""
+import os, sys, glob, argparse
+import cv2
+import numpy as np
+
+def colorize(label_img, alpha=0.55, bgr_img=None, skip=()):
+    """Colour each integer instance id and alpha-blend over the photo."""
+    rng = np.random.default_rng(0)
+    ids = [i for i in np.unique(label_img) if i != 0 and i not in skip]
+    overlay = np.zeros((*label_img.shape, 3), np.uint8)
+    for i in ids:
+        overlay[label_img == i] = rng.integers(60, 255, 3)
+    out = bgr_img.copy()
+    m = np.isin(label_img, ids)
+    out[m] = (alpha * overlay[m] + (1 - alpha) * bgr_img[m]).astype(np.uint8)
+    # outline each instance
+    for i in ids:
+        cnts, _ = cv2.findContours((label_img == i).astype(np.uint8),
+                                   cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+        cv2.drawContours(out, cnts, -1, (255, 255, 255), 1)
+    return out, ids
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--image", required=True)
+    ap.add_argument("--leaf", help="leaf_instance png")
+    ap.add_argument("--plant", help="plant_instance png")
+    ap.add_argument("--masks_dir", help="raw leaf_mask dir")
+    ap.add_argument("--out", default="viz")
+    a = ap.parse_args()
+
+    img = cv2.imread(a.image)
+    os.makedirs(a.out, exist_ok=True)
+    panels = [("original", img)]
+
+    if a.masks_dir and os.path.isdir(a.masks_dir):
+        rng = np.random.default_rng(1)
+        drawn = img.copy()
+        paths = sorted(glob.glob(os.path.join(a.masks_dir, "*.png")))
+        masks = [cv2.imread(p, -1) for p in paths]
+        masks = sorted(masks, key=lambda m: np.count_nonzero(m), reverse=True)
+        for m in masks:
+            drawn[m > 0] = (0.5 * rng.integers(60, 255, 3) + 0.5 * drawn[m > 0]).astype(np.uint8)
+        cv2.imwrite(os.path.join(a.out, "leaf_mask_candidates.png"), drawn)
+        panels.append(("leaf mask candidates (%d)" % len(masks), drawn))
+
+    if a.leaf and os.path.exists(a.leaf):
+        lab = cv2.imread(a.leaf, cv2.IMREAD_UNCHANGED)
+        vis, ids = colorize(lab, bgr_img=img)
+        cv2.imwrite(os.path.join(a.out, "leaf_instances.png"), vis)
+        panels.append(("leaf instances (%d)" % len(ids), vis))
+        print("leaf instances:", len(ids))
+
+    if a.plant and os.path.exists(a.plant):
+        lab = cv2.imread(a.plant, cv2.IMREAD_UNCHANGED)
+        # 9999 is the "outlier" colour written by majority_voting_masks_plants
+        vis, ids = colorize(lab, bgr_img=img, skip=(9999,))
+        cv2.imwrite(os.path.join(a.out, "plant_instances.png"), vis)
+        panels.append(("plant instances (%d)" % len(ids), vis))
+        sizes = {int(i): int((lab == i).sum()) for i in ids}
+        print("plant instances:", len(ids))
+        for k, v in sorted(sizes.items(), key=lambda kv: -kv[1]):
+            print("   id %-5d %8d px  (%.1f%% of frame)" % (k, v, 100 * v / lab.size))
+
+    # side-by-side contact sheet
+    h = img.shape[0]
+    sheet = []
+    for title, p in panels:
+        p = p.copy()
+        cv2.rectangle(p, (0, 0), (p.shape[1], 26), (0, 0, 0), -1)
+        cv2.putText(p, title, (6, 18), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
+        sheet.append(p)
+    cv2.imwrite(os.path.join(a.out, "contact_sheet.png"), np.hstack(sheet))
+    print("wrote", os.path.join(a.out, "contact_sheet.png"))
+
+if __name__ == "__main__":
+    main()
