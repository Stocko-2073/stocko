new file mode 100644
index 0000000..26686b8
--- /dev/null
+++ b/viz_compare.py
@@ -0,0 +1,45 @@
+"""Render plant-instance label maps with a maximally-distinct palette."""
+import sys, os, colorsys
+import numpy as np, cv2
+
+def palette(n):
+    cols = []
+    for i in range(n):
+        h = (i * 0.61803398875) % 1.0                 # golden-ratio hue spacing
+        s = 0.75 + 0.25 * ((i % 3) / 2)
+        v = 0.65 + 0.35 * ((i % 2))
+        r, g, b = colorsys.hsv_to_rgb(h, s, v)
+        cols.append((int(b * 255), int(g * 255), int(r * 255)))  # BGR
+    return cols
+
+def render(img, lab, alpha=0.6, skip=(0, 9999), label_ids=True):
+    ids = [i for i in np.unique(lab) if i not in skip]
+    ids = sorted(ids, key=lambda i: -(lab == i).sum())
+    cols = palette(len(ids))
+    out = img.copy()
+    for c, i in zip(cols, ids):
+        m = lab == i
+        out[m] = (alpha * np.array(c) + (1 - alpha) * img[m]).astype(np.uint8)
+        cnts, _ = cv2.findContours(m.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+        cv2.drawContours(out, cnts, -1, (255, 255, 255), 2)
+        if label_ids and m.sum() > 4000:
+            ys, xs = np.where(m)
+            cx, cy = int(xs.mean()), int(ys.mean())
+            txt = "%d" % i
+            cv2.putText(out, txt, (cx - 12, cy), cv2.FONT_HERSHEY_SIMPLEX, 1.1, (0, 0, 0), 5)
+            cv2.putText(out, txt, (cx - 12, cy), cv2.FONT_HERSHEY_SIMPLEX, 1.1, (255, 255, 255), 2)
+    return out, ids
+
+if __name__ == "__main__":
+    img = cv2.imread("data/squash/test/images/plants.png")
+    os.makedirs("viz", exist_ok=True)
+    for path, name in [(p, os.path.splitext(os.path.basename(p))[0]) for p in sys.argv[1:]]:
+        lab = cv2.imread(path, cv2.IMREAD_UNCHANGED)
+        out, ids = render(img, lab)
+        dst = os.path.join("viz", "render_%s.png" % name)
+        cv2.imwrite(dst, out)
+        tot = lab.size
+        print("%s -> %d instances" % (name, len(ids)))
+        for i in ids[:6]:
+            print("    id %-4d %7d px  %5.1f%%" % (i, (lab == i).sum(), 100 * (lab == i).sum() / tot))
+        print("    wrote", dst)
