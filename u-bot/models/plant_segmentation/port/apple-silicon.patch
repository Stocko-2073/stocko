diff --git a/recluster.py b/recluster.py
new file mode 100644
index 0000000..6e2f5c7
--- /dev/null
+++ b/recluster.py
@@ -0,0 +1,52 @@
+"""Re-run only the DBSCAN stage of plant_segmentation.py from cached leaf keypoints.
+
+plant_segmentation.py saves the GroundingDINO-derived leaf-root keypoints to
+<img>.npy (and, with our patch, the matching ids to <img>_mask_ids.npy), so the
+expensive attention step does not have to be repeated to try a different eps.
+"""
+import argparse, os
+import numpy as np
+import cv2
+
+from utils.fileio import str_to_tuple
+from plant_segmentation import (greedyDBSCANclustering, majority_voting_masks_plants,
+                                post_process_outliers, load_binary_masks_as_dict)
+
+def run(points, mask_ids, masks_dir, eps, min_samples, num_steps, out_size, min_area_th):
+    clustering = greedyDBSCANclustering(points, eps=eps, min_samples=min_samples,
+                                        num_steps=num_steps) + 1
+    leaf_mask_dict = load_binary_masks_as_dict(masks_dir)
+    seg = majority_voting_masks_plants(leaf_mask_dict, clustering, mask_ids,
+                                       outlier_label=0, output_img_size=out_size,
+                                       min_area_th=min_area_th)
+    proc = post_process_outliers(seg, points, clustering, 0, GENERATE_NEW_CLUSTER=True)
+    seg_pp = majority_voting_masks_plants(leaf_mask_dict, proc, mask_ids,
+                                          outlier_label=0, output_img_size=out_size,
+                                          min_area_th=min_area_th)
+    return seg_pp, clustering
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--points", default="plants.npy")
+    ap.add_argument("--mask_ids", default="plants_mask_ids.npy")
+    ap.add_argument("--masks_dir", default="output_p/leaf_mask/squash/test/plants")
+    ap.add_argument("--eps", type=float, nargs="+", default=[60])
+    ap.add_argument("--min_samples", type=int, default=2)
+    ap.add_argument("--num_steps", type=int, default=15)
+    ap.add_argument("--size", default="(1024, 768)")
+    ap.add_argument("--min_area_th", type=int, default=300)
+    ap.add_argument("--out", default="output_p/plant_instance/squash/test")
+    a = ap.parse_args()
+
+    pts = np.load(a.points); ids = np.load(a.mask_ids).tolist()
+    size = str_to_tuple(a.size)
+    os.makedirs(a.out, exist_ok=True)
+    print("keypoints:", pts.shape, "ids:", len(ids))
+    for eps in a.eps:
+        seg, clustering = run(pts, ids, a.masks_dir, eps, a.min_samples,
+                              a.num_steps, size, a.min_area_th)
+        n = len([i for i in np.unique(seg) if i not in (0, 9999)])
+        path = os.path.join(a.out, "plants_eps%g.png" % eps)
+        cv2.imwrite(path, seg)
+        sizes = sorted(((seg == i).sum() for i in np.unique(seg) if i not in (0, 9999)), reverse=True)
+        print("eps=%-5g -> %2d plant instances; largest %s px" % (eps, n, sizes[:4]))
