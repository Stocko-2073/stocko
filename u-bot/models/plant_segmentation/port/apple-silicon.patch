@@ -0,0 +1,79 @@
+"""Final figures: leaf stage, plant-instance stage, and a squash-vs-rest reading."""
+import os, colorsys
+import numpy as np, cv2
+
+IMG   = "data/squash/test/images/plants.png"
+LEAF  = "output_p/leaf_instance/squash/test/plants.png"
+PLANT = "output_p/plant_instance/squash/test/plants.png"
+OUT   = "viz"
+
+def palette(n):
+    out = []
+    for i in range(n):
+        h = (i * 0.61803398875) % 1.0
+        r, g, b = colorsys.hsv_to_rgb(h, 0.8, 0.95)
+        out.append((int(b*255), int(g*255), int(r*255)))
+    return out
+
+def blend(img, mask, color, alpha=0.6, outline=True, thick=2):
+    out = img.copy()
+    out[mask] = (alpha*np.array(color) + (1-alpha)*img[mask]).astype(np.uint8)
+    if outline:
+        cnts,_ = cv2.findContours(mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+        cv2.drawContours(out, cnts, -1, (255,255,255), thick)
+    return out
+
+def title(img, text):
+    out = img.copy()
+    cv2.rectangle(out, (0,0), (out.shape[1], 34), (20,20,20), -1)
+    cv2.putText(out, text, (10,24), cv2.FONT_HERSHEY_SIMPLEX, 0.62, (255,255,255), 2)
+    return out
+
+img  = cv2.imread(IMG)
+leaf = cv2.imread(LEAF,  cv2.IMREAD_UNCHANGED)
+pl   = cv2.imread(PLANT, cv2.IMREAD_UNCHANGED)
+os.makedirs(OUT, exist_ok=True)
+
+# --- leaf instances ---
+lids = [i for i in np.unique(leaf) if i != 0]
+cols = palette(len(lids)); vis_leaf = img.copy()
+for c,i in zip(cols, lids):
+    vis_leaf = blend(vis_leaf, leaf==i, c, alpha=0.55, thick=1)
+
+# --- plant instances ---
+pids = sorted([i for i in np.unique(pl) if i not in (0,9999)], key=lambda i:-(pl==i).sum())
+cols = palette(len(pids)); vis_pl = img.copy()
+for c,i in zip(cols, pids):
+    vis_pl = blend(vis_pl, pl==i, c, alpha=0.6)
+for i in pids:
+    m = pl==i
+    if m.sum() > 4000:
+        ys,xs = np.where(m); cx,cy = int(xs.mean()), int(ys.mean())
+        for col,th in [((0,0,0),5),((255,255,255),2)]:
+            cv2.putText(vis_pl, str(i), (cx-12,cy), cv2.FONT_HERSHEY_SIMPLEX, 1.1, col, th)
+
+print("plant instances:", len(pids))
+tot = pl.size
+for i in pids:
+    print("   id %-4d %7d px  %5.1f%%" % (i, (pl==i).sum(), 100*(pl==i).sum()/tot))
+
+# --- squash vs rest: the three biggest instances are the squash's own fragments ---
+squash_ids = pids[:3]
+rest_ids   = pids[3:]
+sq   = np.isin(pl, squash_ids)
+rest = np.isin(pl, rest_ids)
+vis_sr = blend(img, sq,   (60,200,60), alpha=0.55)          # green  = squash
+vis_sr = blend(vis_sr, rest, (40,40,235), alpha=0.55)        # red    = other plants
+print("\nsquash fragments %s -> %.1f%% of frame" % (squash_ids, 100*sq.sum()/tot))
+print("other plants     %s -> %.1f%% of frame" % (rest_ids, 100*rest.sum()/tot))
+
+cv2.imwrite(f"{OUT}/final_leaf_instances.png", vis_leaf)
+cv2.imwrite(f"{OUT}/final_plant_instances.png", vis_pl)
+cv2.imwrite(f"{OUT}/final_squash_vs_rest.png", vis_sr)
+
+sheet = np.hstack([title(img,"1. input photo"),
+                   title(vis_leaf, "2. leaf instances (%d)" % len(lids)),
+                   title(vis_pl,   "3. plant instances (%d)" % len(pids)),
+                   title(vis_sr,   "4. squash (green) vs other plants (red)")])
+cv2.imwrite(f"{OUT}/final_contact_sheet.png", sheet)
+print("\nwrote", f"{OUT}/final_contact_sheet.png", sheet.shape)
