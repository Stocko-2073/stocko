# The repository root routes *.png through Git LFS, which would catch every
# image in an Xcode asset catalog. That is friction with no benefit here: an
# app icon is around 100 kB, and a clone made without git-lfs would leave a
# pointer file where actool expects a PNG, which fails the build outright with
# a confusing error. A more specific .gitattributes wins, and `!attr` sets the
# attribute back to unspecified so the LFS filter never runs.
*.png  !filter !diff !merge -text
*.pdf  !filter !diff !merge -text

# project.pbxproj is generated by XcodeGen and gitignored, but if one is ever
# committed deliberately, do not let git guess about it.
*.pbxproj  -text

*.swift  text eol=lf
*.plist  text eol=lf
*.yml    text eol=lf
